{
  "packages": {
    ".": {
      "release-type": "go",
      "versioning": "default",
      "bump-minor-pre-major": true,
      "bump-patch-for-minor-pre-major": false,
      "include-component-in-tag": false,
      "include-v-in-tag": true,
      "extra-files": [
        "aiserver/lifecycle.go",
        "bedrockagents/handler.go",
        "bedrockmessages/handler.go",
        "claudeagents/handler.go",
        "claudemessages/handler.go",
        "langchainagents/handler.go",
        "langchainmessages/handler.go",
        "openaiagents/handler.go",
        "openaimessages/handler.go"
      ],
      "exclude-paths": [
        ".github"
      ],
      "initial-version": "0.1.0"
    }
  }
}
