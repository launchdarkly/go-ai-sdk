# Observability
LD_ENVIRONMENT=
LD_ENVIRONMENT_ID=
LD_SERVICE_NAME=
OTEL_EXPORTER_OTLP_ENDPOINT=

# Evaluations from Code (experimental)
LD_API_TOKEN=
